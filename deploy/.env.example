# Isolate Compose project (avoid clashing with seedao-v1-web / seedao-pwa / other stacks)
COMPOSE_PROJECT_NAME=seedao-v1-app

# Host port (must match Nginx proxy_pass). Default 3081 (seedao-v1-web uses 3080).
HOST_PORT=3081

# Pre-built image from GitHub Actions (required).
# After first successful workflow run, replace OWNER/REPO with your GitHub path (lowercase).
# Examples:
#   WEB_IMAGE=ghcr.io/seedao-polis/seedao-v1-app:latest
#   WEB_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/seedao-v1-app:latest
WEB_IMAGE=ghcr.io/OWNER/REPO:latest
